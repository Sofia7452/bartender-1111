// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String?  // 密码哈希，可选（支持匿名用户升级为注册用户）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]

  // 用户收藏关联（登录用户的收藏）
  favorites AuthUserFavorite[]
  savedSets AuthUserSavedSet[]
}

// 登录用户的收藏（与匿名用户的 UserFavorite 区分）
model AuthUserFavorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    Int
  recipeId  String   @db.Uuid
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("auth_user_favorites")
}

// 登录用户的套装收藏
model AuthUserSavedSet {
  id          String   @id @default(uuid()) @db.Uuid
  userId      Int
  dishId      String   @db.Uuid
  name        String?  @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dish    Dish                   @relation(fields: [dishId], references: [id], onDelete: Cascade)
  recipes AuthUserSavedSetRecipe[]

  @@unique([userId, dishId])
  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("auth_user_saved_sets")
}

model AuthUserSavedSetRecipe {
  id         String   @id @default(uuid()) @db.Uuid
  savedSetId String   @db.Uuid
  recipeId   String   @db.Uuid
  createdAt  DateTime @default(now())

  savedSet AuthUserSavedSet @relation(fields: [savedSetId], references: [id], onDelete: Cascade)
  recipe   Recipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([savedSetId, recipeId])
  @@index([savedSetId])
  @@index([recipeId])
  @@map("auth_user_saved_set_recipes")
}

model Post {
  id        Int     @id @default(autoincrement())
  title     String
  content   String?
  published Boolean @default(false)
  authorId  Int
  author    User    @relation(fields: [authorId], references: [id])
}

model Dish {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String   @db.VarChar(255)
  description         String?  @db.Text
  cuisine             String   @db.VarChar(100)
  requiredIngredients Json // string[] - 所需食材列表，包含用量信息
  cookingTime         Int      @default(30) // 烹饪时间（分钟）
  difficulty          Int      @default(3) // 难度等级，1-5
  steps               Json // string[] - 烹饪步骤列表
  source              String?  @db.VarChar(255)
  tags                Json? // string[] - 分类标签（可选）
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // 关联关系
  savedSets         SavedSet[]
  authUserSavedSets AuthUserSavedSet[]

  @@index([name])
  @@index([cuisine])
  @@map("dishes")
}

model Recipe {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(255)
  description   String?  @db.Text
  ingredients   Json // string[]
  steps         Json // string[]
  difficulty    Int      @default(1)
  estimatedTime Int      @default(0)
  source        String?  @db.VarChar(255)
  category      String?  @db.VarChar(50)
  glassType     String?  @db.VarChar(50)
  technique     String?  @db.VarChar(50)
  garnish       String?  @db.Text
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // 关联关系
  favorites              UserFavorite[]
  savedSetRecipes        SavedSetRecipe[]
  authUserFavorites      AuthUserFavorite[]
  authUserSavedSetRecipes AuthUserSavedSetRecipe[]

  @@map("recipes")
}

model UserFavorite {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @db.VarChar(255)
  recipeId  String   @db.Uuid
  createdAt DateTime @default(now())

  // 关联关系
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([sessionId, recipeId])
  @@index([sessionId, recipeId])
  @@index([sessionId, createdAt(sort: Desc)]) // 优化按时间排序的查询
  @@map("user_favorites")
}

model SavedSet {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @db.VarChar(255)
  dishId      String   @db.Uuid
  name        String?  @db.VarChar(255) // 套装名称（可选，用于用户自定义命名）
  description String?  @db.Text // 套装描述（可选）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关联关系
  dish    Dish             @relation(fields: [dishId], references: [id], onDelete: Cascade)
  recipes SavedSetRecipe[]

  @@unique([sessionId, dishId])
  @@index([sessionId])
  @@index([dishId])
  @@index([sessionId, createdAt(sort: Desc)]) // 优化按时间排序的查询
  @@map("saved_sets")
}

model SavedSetRecipe {
  id         String   @id @default(uuid()) @db.Uuid
  savedSetId String   @db.Uuid
  recipeId   String   @db.Uuid
  createdAt  DateTime @default(now())

  // 关联关系
  savedSet SavedSet @relation(fields: [savedSetId], references: [id], onDelete: Cascade)
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([savedSetId, recipeId])
  @@index([savedSetId])
  @@index([recipeId])
  @@map("saved_set_recipes")
}

model KnowledgeDocument {
  id           String   @id @default(uuid()) @db.Uuid
  title        String   @db.VarChar(255)
  content      String   @db.Text
  milvusId     String?  @db.Text
  metadata     Json? // 文档元数据（文件路径、大小、页数等）
  documentType String   @default("pdf") @db.VarChar(50)
  filePath     String?  @db.VarChar(255)
  fileSize     BigInt?
  chunkCount   Int      @default(0)
  isProcessed  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([title])
  @@map("knowledge_documents")
}

model RecommendationHistory {
  id                 String   @id @default(uuid()) @db.Uuid
  sessionId          String   @db.VarChar(255)
  ingredients        Json // string[] - 用户输入的原料
  recommendedRecipes Json // any[] - 推荐的配方数据（JSON格式）
  queryType          String?  @db.VarChar(50) // 查询类型（如ingredient_match, recipe_search等）
  searchMetadata     Json? // 搜索元数据（如搜索参数、结果数量等）
  createdAt          DateTime @default(now())

  @@index([sessionId, createdAt])
  @@map("recommendation_history")
}
